# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.

# ── Cloudflare account (shared by R2 + D1 admin scripts) ────────────────────
CLOUDFLARE_ACCOUNT_ID=""

# Cloudflare R2 — only needed for admin-side CLI tooling (bucket inspection
# etc). The app itself talks to R2 through the wrangler binding, not these.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_DOMAIN=""

# Cloudflare D1 — used by `drizzle-kit studio`/`push` (see drizzle.config.ts).
# Actual app queries go through the wrangler binding configured in
# wrangler.jsonc (copy wrangler.example.jsonc to get started).
D1_API_TOKEN=""
D1_DATABASE_ID=""
D1_DATABASE_NAME=""

# Fallback WhatsApp number used only if no settings row exists yet in D1
# (fresh install) — set your real number via the admin Config Settings tab
# once deployed instead of relying on this.
DEFAULT_WHATSAPP_NUMBER=""

# Canonical public site URL — used for SEO metadata (canonical/OG URLs, JSON-LD, sitemap.xml)
SITE_URL=""

# Serves /admin at this subdomain (see middleware.ts) — leave unset to disable
ADMIN_HOST=""

# ── Branding (see lib/branding.ts) ───────────────────────────────────────────
# All optional — every field has a generic default. Set these to restore
# your real company identity on your own deployment without touching the
# committed defaults (which stay generic for anyone else who clones this).
NEXT_PUBLIC_COMPANY_NAME=""
NEXT_PUBLIC_TAGLINE=""
NEXT_PUBLIC_REGION_LABEL=""
NEXT_PUBLIC_ADMIN_DISPLAY_NAME=""
NEXT_PUBLIC_ADMIN_ROLE=""
NEXT_PUBLIC_DEFAULT_CATEGORIES=""
NEXT_PUBLIC_POWERED_BY_LABEL=""
NEXT_PUBLIC_POWERED_BY_URL=""

# Logo image + PWA manifest paths — point these at your own real files
# (e.g. /logo.png, /manifest.json) if you keep them outside git; otherwise
# leave unset to use the generic committed placeholders.
NEXT_PUBLIC_LOGO_SRC=""
NEXT_PUBLIC_ICON_SRC=""
NEXT_PUBLIC_THEME_COLOR=""
NEXT_PUBLIC_MANIFEST_PATH=""
NEXT_PUBLIC_ADMIN_MANIFEST_PATH=""

# Public landing page content (app/page.tsx) — About text, contact details,
# map link, and the two product taxonomy lists shown on the homepage. All
# optional; the page falls back to generic placeholder copy if unset.
NEXT_PUBLIC_ABOUT_TEXT=""
NEXT_PUBLIC_ABOUT_TEXT_SHORT=""
NEXT_PUBLIC_FOUNDED_YEAR=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_ADDRESS_LINE=""
NEXT_PUBLIC_MAP_URL=""
NEXT_PUBLIC_MAP_EMBED_CID=""
NEXT_PUBLIC_SERVICE_AREA_TEXT=""
NEXT_PUBLIC_PRODUCT_SERIES=""
NEXT_PUBLIC_PRODUCT_TYPES=""
NEXT_PUBLIC_META_DESCRIPTION=""
NEXT_PUBLIC_META_KEYWORDS=""

# Brand color scale (tailwind.config.ts) — set any subset of shades to
# override the generic default palette. Unset shades fall back to the
# generic scale.
# BRAND_50=""
# BRAND_100=""
# BRAND_200=""
# BRAND_300=""
# BRAND_400=""
# BRAND_500=""
# BRAND_600=""
# BRAND_700=""
# BRAND_800=""
# BRAND_900=""
# BRAND_950=""
