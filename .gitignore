# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example

# wrangler.jsonc contains real per-account Cloudflare resource IDs (D1/R2/worker
# name) — keep it local-only and commit wrangler.example.jsonc instead
/wrangler.jsonc

# generated by `wrangler types` — huge and machine-specific, regenerate via
# `npm run cf-typegen`
cloudflare-env.d.ts

# stray local Python venv, unrelated to this project
.venv/

# real brand assets — kept local-only; generic placeholders are committed
# as logo-demo.png / icon-demo.png / icon-admin-demo.png instead
/public/logo.png
/public/icon.png
/public/icon-admin.png

# real PWA manifests — kept local-only; generic placeholders are committed
# as manifest-demo.json / manifest-admin-demo.json (see .env.example)
/public/manifest.json
/public/manifest-admin.json

# real favicon — kept local-only (derived from the real brand icon above).
# Next.js's app/favicon.ico is a fixed filename with no env-driven override,
# so unlike logo/icon there's no generic committed alternative; a fresh
# GitHub clone simply has no favicon until you add your own.
/app/favicon.ico
