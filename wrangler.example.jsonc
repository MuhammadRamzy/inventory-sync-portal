// Copy this file to wrangler.jsonc and fill in your own Cloudflare resource
// IDs. wrangler.jsonc is gitignored since it holds per-account identifiers
// (D1 database id, R2 bucket name, Worker name) that are specific to your
// Cloudflare account, not something to share/commit.
//
// Setup:
//   1. npx wrangler d1 create <your-db-name>        → copy the database_id below
//   2. npx wrangler r2 bucket create <your-bucket>   → put the name below
//   3. cp wrangler.example.jsonc wrangler.jsonc
//   4. npm run db:migrate:remote   (applies drizzle/*.sql to the new D1 db)
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "your-app-name",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match "name" above
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "your-app-name"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "your-db-name",
			"database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
			"migrations_dir": "drizzle",
			// Single-environment project (no separate dev/staging D1) — talk to
			// the real database directly instead of a local sqlite simulation.
			// Set to false if you'd rather develop against a local D1 sandbox.
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "IMAGES_BUCKET",
			"bucket_name": "your-bucket-name",
			"remote": true
		}
	]
	// Optional: serve on your own domain(s) instead of the *.workers.dev URL.
	// Requires the domain to already be an active zone in this Cloudflare
	// account. Set ADMIN_HOST in .env to the admin hostname you use below so
	// middleware.ts knows to route it to /admin.
	// "routes": [
	// 	{ "pattern": "your-domain.com", "custom_domain": true },
	// 	{ "pattern": "admin.your-domain.com", "custom_domain": true }
	// ]
}
